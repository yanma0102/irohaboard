# VCS / エディタ / CI
.git
.gitignore
.dockerignore
.editorconfig
.slim
.github

# ドキュメント
*.md
LICENSE

# 開発・検証用（イメージには不要）
Dev/

# アプリの実行時生成物・秘密情報（ビルドコンテキストから除外）
app/tmp/
app/logs/
app/tests.sqlite
app/.phpunit.cache
app/config/app_local.php
app/config/.env
*.log
.DS_Store
Thumbs.db

# アップロード画像は同梱しない（.htaccess のみ同梱）
app/webroot/uploads/*
!app/webroot/uploads/.htaccess
