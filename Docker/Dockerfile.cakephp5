FROM php:8.4-apache

# Composer 本体を同梱（コンテナ内で `composer install` を実行できるようにする）
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

# PHP拡張モジュールインストール
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libldap2-dev \
    libsasl2-dev \
    unzip \
    git \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-configure ldap --with-libdir=lib/x86_64-linux-gnu \
    && docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    mbstring \
    gd \
    intl \
    opcache \
    zip \
    bcmath \
    ldap \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Apache mod_rewrite / mod_headers 有効化
RUN a2enmod rewrite headers

# Apache 設定ファイルをコピー
COPY Docker/apache-vhost.cakephp5.conf /etc/apache2/sites-available/000-default.conf
COPY Docker/apache-app.conf /etc/apache2/conf-available/irohaboard.conf
RUN a2enconf irohaboard \
    && echo 'ServerName localhost' >> /etc/apache2/apache2.conf

# Apache MPM(prefork) 設定をコピー（ワーカー数上限と定期再生成でメモリ肥大を防止）
COPY Docker/mpm-prefork.conf /etc/apache2/mods-available/mpm_prefork.conf

# PHP 設定ファイルをコピー
COPY Docker/php.ini /usr/local/etc/php/conf.d/app.ini

# アプリ本体をイメージに同梱（vendor 含む。ネットワーク不要で起動できる）
COPY app/ /var/www/html/

# app_local.php を example から生成し、ランダムな SECURITY_SALT を焼き込む
# （DB 接続情報などは実行時に compose の環境変数から注入される）
RUN cp /var/www/html/config/app_local.example.php /var/www/html/config/app_local.php \
    && SALT="$(php -r 'echo bin2hex(random_bytes(32));')" \
    && sed -i "s/__SALT__/${SALT}/" /var/www/html/config/app_local.php \
    && mkdir -p /var/www/html/tmp /var/www/html/logs /var/www/html/files /var/www/html/webroot/uploads \
    && chown -R www-data:www-data /var/www/html/tmp /var/www/html/logs /var/www/html/files /var/www/html/webroot/uploads

# named volume で uploads が隠れた場合に .htaccess を復元するためのテンプレート
COPY app/webroot/uploads/.htaccess /usr/local/share/irohaboard/uploads.htaccess

# 起動エントリポイント（所有権調整と Apache 起動）
COPY Docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["apache2-foreground"]