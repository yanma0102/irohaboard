# LDAP初期データ: ou=people とテストユーザー投入
# (osixia/openldap はベースDNとcn=adminのみ作成するため、ou はここで作成する)

dn: ou=people,dc=irohaboard,dc=local
objectClass: top
objectClass: organizationalUnit
ou: people

dn: uid=ldapuser1,ou=people,dc=irohaboard,dc=local
objectClass: top
objectClass: inetOrgPerson
cn: LDAP Test User 1
sn: LDAPUser1
displayName: LDAP テストユーザー 1
uid: ldapuser1
mail: ldapuser1@irohaboard.local
userPassword: ldappass1

dn: uid=ldapuser2,ou=people,dc=irohaboard,dc=local
objectClass: top
objectClass: inetOrgPerson
cn: LDAP Test User 2
sn: LDAPUser2
displayName: LDAP テストユーザー 2
uid: ldapuser2
mail: ldapuser2@irohaboard.local
userPassword: ldappass2

dn: uid=ldapadmin,ou=people,dc=irohaboard,dc=local
objectClass: top
objectClass: inetOrgPerson
cn: LDAP Admin User
sn: LDAPAdmin
displayName: LDAP 管理者ユーザー
uid: ldapadmin
mail: ldapadmin@irohaboard.local
userPassword: ldapadminpass
