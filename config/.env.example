#!/usr/bin/env bash
# iroha Board 用の環境変数（開発・本番共通のテンプレート）
#
# 使い方:
#   cp config/.env.example config/.env
#   必要に応じて値を編集する
#
# 本番では DB / SECURITY 情報が含まれるため、ファイルを .gitignore に入れて
# treat as secret とする（config/.env は git 追跡対象外）

export APP_NAME="iroha Board"
export DEBUG="true"
export APP_ENCODING="UTF-8"
export APP_DEFAULT_LOCALE="ja_JP"
export APP_DEFAULT_TIMEZONE="Asia/Tokyo"
# SECURITY: 本番でドメインを設定し、Host Header Injection を防ぐ
export APP_FULL_BASE_URL="http://localhost:8082"
# インストール前にランダムな文字列に変更する（変更後にログイン不可になるため注意）
export SECURITY_SALT="397110e45242a23e5802e78f4eec95a7bd39e0f0"

# データベース接続（ローカル MariaDB 11.4 の開発ポート 13307）
export DB_HOST="127.0.0.1"
export DB_PORT="13307"
export DB_NAME="irohaboard"
export DB_USER="root"
export DB_PASS="rootpass"

# MySQL/MariaDB コンテナ初期設定（docker/docker-compose.cakephp5.yml 参照）
export MYSQL_ROOT_PASSWORD="rootpass"
export MYSQL_DATABASE="irohaboard"
export MYSQL_USER="ib_user"
export MYSQL_PASSWORD="ib_password"